# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ยกเว้นไฟล์ตัวอย่าง — ไม่มีค่าลับ และต้องอยู่ใน repo ให้คนอื่นรู้ว่าต้องตั้งค่าอะไรบ้าง
!.env.example

# ไฟล์ต้นทางที่ดาวน์โหลดมาแปลงเป็นแผนที่ (ดู scripts/build-province-paths.mjs)
# ไม่ต้อง commit เพราะ generate ใหม่ได้เสมอ และผลลัพธ์อยู่ใน src/lib/data/province-paths.ts แล้ว
.cache

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code — allowlist คำสั่งเฉพาะเครื่อง ไม่ใช่ค่ากลางของทีมเหมือน settings.json
.claude/settings.local.json

# impeccable — ไฟล์ state/runtime ของเครื่องมือ (PRODUCT.md ที่มันสร้างเป็นเอกสารจริง เก็บไว้ตามปกติ)
.impeccable/
